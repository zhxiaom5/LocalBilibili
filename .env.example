# Server bind address. Use 127.0.0.1 for a machine-local installation.
LOCALBILIBILI_ADDR=:8080

# Store persistent data outside the repository.
LOCALBILIBILI_DB=./data/localbilibili.db
LOCALBILIBILI_CONFIG=./data/localbilibili.config.json

# Required only when the database does not yet exist. Choose a unique username
# and a long random password before first startup; never commit the real values.
LOCALBILIBILI_BOOTSTRAP_USERNAME=admin
LOCALBILIBILI_BOOTSTRAP_PASSWORD=

# Optional development-only override for built frontend files.
# LOCALBILIBILI_WEB_DIR=

# Optional path to an executable yt-dlp binary. Do not place cookies here.
# LOCALBILIBILI_YTDLP=yt-dlp
